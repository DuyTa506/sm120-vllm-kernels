diff -ruN -x __pycache__ a/vllm/v1/core/session_state_cache.py b/vllm/v1/core/session_state_cache.py
--- a/vllm/v1/core/session_state_cache.py	1970-01-01 08:00:00.000000000 +0800
+++ b/vllm/v1/core/session_state_cache.py	2026-10-25 15:10:59.771883019 +0700
