+            m=m1,
+            k=k1_sf * 16,
+            num_groups=num_experts_w1,
+        )
+        num_experts_w2, m2, k2_sf = self.w2_scale.shape
+        self.w2_sf_mma = flashinfer_convert_sf_to_mma_layout(
+            self.w2_scale.reshape(num_experts_w2 * m2, k2_sf),
+            m=m2,
+            k=k2_sf * 16,
+            num_groups=num_experts_w2,
+        )
