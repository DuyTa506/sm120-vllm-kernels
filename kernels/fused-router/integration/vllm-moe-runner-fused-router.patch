+    def _fused_router_eligible(self) -> bool:
+        """Every condition under which the fused kernel reproduces gate(x) -> FusedTopKRouter exactly."""
+        import os
+
+        from vllm.model_executor.layers.fused_moe.router.fused_topk_router import FusedTopKRouter
+
+        if os.environ.get("VLLM_FUSED_ROUTER", "0") != "1" or not current_platform.is_cuda():
+            return False
+        gate, router, mc = self.gate, self.router, self.moe_config
+        w = getattr(gate, "weight", None)
+        return (
+            gate is not None
+            and not self._fse_fuse_gate
+            and w is not None
+            and w.dtype == torch.bfloat16
+            and w.dim() == 2
+            and w.is_contiguous()
+            and w.shape[0] <= 256
+            and w.shape[1] % 32 == 0
+            and getattr(gate, "is_unquantized", False)
+            and getattr(gate, "out_dtype", None) is None   # bf16 logits, like the unfused path
+            and getattr(gate, "bias", None) is None
+            and type(router) is FusedTopKRouter
+            and router.scoring_func == "softmax"
+            and router.eplb_state is None
+            and router.capture_fn is None
+            and 1 <= router.top_k <= 32
+            and not self._quant_method.is_monolithic
+            and self._quant_method.topk_indices_dtype in (None, torch.int32)
+            and mc.moe_parallel_config.dp_size == 1
+            and mc.moe_parallel_config.ep_size == 1
+            and mc.moe_parallel_config.tp_size == 1
+            and mc.moe_parallel_config.sp_size == 1
+            and mc.moe_parallel_config.pcp_size == 1
+            and self.routed_input_transform is None
+        )
+
+    def _maybe_fused_router(
+        self, hidden_states: torch.Tensor
+    ) -> tuple[torch.Tensor, torch.Tensor] | None:
+        """(topk_weights, topk_ids) from the fused kernel, or None to take the unfused path."""
+        if self._fused_router_ok is None:
+            self._fused_router_ok = self._fused_router_eligible()
+            if self._fused_router_ok:
+                logger.info_once("VLLM_FUSED_ROUTER=1: using the fused router kernel for <= %d tokens",
+                                 _FUSED_ROUTER_MAX_TOKENS)
+        num_tokens = hidden_states.shape[0]
+        if (
+            not self._fused_router_ok
+            or num_tokens > _FUSED_ROUTER_MAX_TOKENS
+            or hidden_states.dtype != torch.bfloat16
+            or hidden_states.stride(-1) != 1
+        ):
+            return None
+        from vllm.model_executor.layers.fused_moe.router.fused_topk_router import _get_padding_mask
+
+        fr = _load_fused_router()
+        dev = hidden_states.device
+        ws = _fused_router_ws.get(dev)
+        if ws is None:   # layers run back to back on one stream, so one scratch is enough
+            ws = _fused_router_ws[dev] = fr.Workspace(dev, max_tokens=_FUSED_ROUTER_MAX_TOKENS)
+        topk_weights, topk_ids, _, _ = fr.fused_router(
+            hidden_states,
+            self.gate.weight,
+            self.router.top_k,
+            scoring="softmax",
+            renormalize=self.router.renormalize,
+            round_logits=True,
+            ws=ws,
+            pad=_get_padding_mask(num_tokens),
+        )
+        return topk_weights, topk_ids
+
