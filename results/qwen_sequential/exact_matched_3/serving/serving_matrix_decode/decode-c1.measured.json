672c\u601d\u8def\uff1a\u5229\u7528\u52a8\u6001\u89c4\u5212\n# \u5b9a\u4e49\u72b6\u6001\uff1adp[i][v] \u8868\u793a\u524d i \u4ef6\u7269\u54c1\uff08\u90e8\u5206\u6216\u5168\u90e8\uff09\u6070\u653e\u5165\u4e00\u4e2a\u5bb9\u91cf\u4e3a v \u7684\u80cc\u5305\u53ef\u4ee5\u83b7\u5f97\u7684\u6700\u5927\u4ef7\u503c\n# \u72b6\u6001\u8f6c\u79fb\u65b9\u7a0b\uff1adp[i][v] = max(dp[i-1][v], dp[i-1][v-c[i]]+w[i])\n# \u521d\u59cb\u6761\u4ef6\uff1adp[0][v] = 0\n# \u65f6\u95f4\u590d\u6742\u5ea6\uff1aO(NV)\n# \u7a7a\u95f4\u590d\u6742\u5ea6\uff1aO(NV)\ndef knapsack_01(N, V, c, w):\n    dp = [[0 for _ in range(V + 1)] for _ in range(N + 1)]\n    for i in range(1, N + 1):\n        for v in range(1, V + 1):\n            if v < c[i - 1]:\n                dp[i][v] = dp[i - 1][v]\n            else:\n                dp[i][v] = max(dp[i - 1][v], dp[i - 1][v - c[i - 1]] + w[i - 1])\n    return dp[N][V]\n\n# \u7a7a\u95f4\u590d\u6742\u5ea6\uff1aO(V)\ndef knapsack_01_space_opt(N, V, c, w):\n    dp = [0 for _ in range(V + 1)]\n    for i in range(1, N + 1):\n        for v in range(V, c[i - 1] - 1, -1):\n            dp[v] = max(dp[v], dp[v - c[i - 1]] + w[i - 1])\n    return dp[V]\n\n# \u7a7a\u95f4\u590d\u6742\u5ea6\uff1aO(V)\n# \u65f6\u95f4\u590d\u6742\u5ea6\uff1aO(NV)\ndef", " ", ",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\t\"magnus\": \"magnus\",\n\